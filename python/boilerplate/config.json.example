{
    "app": {
        "$app_comments": "The app information section provides metadata about the application.",
        "app_name": "BoilerplateApp",
        "environment": "production",
        "version": "1.0.0"
    },
    "amqp": {
        "$amqp_comments": "The AMQP configuration section provides settings for connecting to the AMQP broker.",
        "host": "localhost",
        "port": 5672,
        "username": "user",
        "password": "password",
        "queue_name": "boilerplate_queue",
        "exchange_name": "boilerplate_exchange",
        "routing_key": "boilerplate_routing_key",
        "topic_name": "boilerplate_topic",
        "ca_cert": "path/to/ca_cert.pem",
        "cert": "path/to/cert.pem",
        "key": "path/to/key.pem",
        "ssl_enabled": false
    },
    "database": {
        "$database_comments": "The database configuration section provides settings for connecting to the database.",
        "host": "localhost",
        "port": 3306,
        "username": "user",
        "password": "password",
        "database_name": "boilerplate_db",
        "ca_cert": "path/to/ca_cert.pem",
        "ssl_enabled": false
    },
    "zabbix": {
        "$zabbix_comments": "The Zabbix configuration section provides settings for connecting to the Zabbix server. Either use the API or send traps to the Zabbix server. Connect to the Zabbix server using the provided host, port, username, and password. The zabbix_api_url is used for API interactions, and ssl_enabled indicates whether SSL is enabled for secure communication.",
        "host": "localhost",
        "zabbix_server": "zabbix.example.com",
        "zabbix_api_url": "http://zabbix.example.com/api_jsonrpc.php",
        "port": 10051,
        "username": "user",
        "password": "password",
        "ssl_enabled": false
    },
    "file": {
        "$file_comments": "The file configuration section provides settings for file handling. Read the file_path, file_separator, and file_encoding values to configure how the application reads and processes files.",
        "file_path": "path/to/file.txt",
        "file_separator": ";",
        "file_encoding": "utf-8"
    },
    "api": {
        "$api_comments": "The API configuration section provides settings for connecting to external APIs. Configure the api_base_url, api_key, and timeout values to manage API interactions.",
        "api_base_url": "https://api.example.com",
        "api_secret": "your_api_key_here",
        "api_username": "api_user",
        "api_password": "api_password",
        "ca_cert": "path/to/ca_cert.pem",
        "timeout": 30
    }
}